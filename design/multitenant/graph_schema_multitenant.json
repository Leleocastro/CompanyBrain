{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://companybrain.local/schemas/graph_multitenant",
  "title": "CompanyBrain Graph Schema (multi-tenant)",
  "type": "object",
  "definitions": {
    "Person": {
      "type": "object",
      "required": ["id","label","name","tenant_id"],
      "properties": {
        "id": {"type":"string"},
        "label": {"const":"Person"},
        "tenant_id": {"type":"string"},
        "name": {"type":"string"},
        "aliases": {"type":"array","items":{"type":"string"}},
        "email": {"type":"array","items":{"type":"string","format":"email"}},
        "orcid": {"type":"string"},
        "embedding": {"type":"array","items":{"type":"number"}},
        "trust_score": {"type":"number"},
        "created_at": {"type":"string","format":"date-time"}
      }
    },
    "Document": {
      "type": "object",
      "required": ["id","label","title","type","tenant_id"],
      "properties": {
        "id": {"type":"string"},
        "label": {"const":"Document"},
        "tenant_id": {"type":"string"},
        "title": {"type":"string"},
        "type": {"type":"string","enum":["article","pr","issue","post"]},
        "text_summary": {"type":"string"},
        "embedding": {"type":"array","items":{"type":"number"}},
        "language": {"type":"string"},
        "created_at": {"type":"string","format":"date-time"},
        "source_url": {"type":"string","format":"uri"}
      }
    },
    "Repository": {
      "type": "object",
      "required":["id","label","name","tenant_id"],
      "properties":{
        "id":{"type":"string"},
        "label": {"const":"Repository"},
        "tenant_id": {"type":"string"},
        "name":{"type":"string"},
        "host":{"type":"string"},
        "stars":{"type":"integer"},
        "topics":{"type":"array","items":{"type":"string"}},
        "embedding":{"type":"array","items":{"type":"number"}},
        "created_at":{"type":"string","format":"date-time"}
      }
    },
    "Entity": {
      "type":"object",
      "required":["id","label","name","type","tenant_id"],
      "properties":{
        "id":{"type":"string"},
        "label": {"const":"Entity"},
        "tenant_id": {"type":"string"},
        "name":{"type":"string"},
        "type":{"type":"string","enum":["ORG","PERSON","TECH","LOCATION"]},
        "canonical_id":{"type":"string"}
      }
    }
  },
  "properties":{
    "nodes":{
      "type":"array",
      "items":{
        "oneOf":[
          {"$ref":"#/definitions/Person"},
          {"$ref":"#/definitions/Document"},
          {"$ref":"#/definitions/Repository"},
          {"$ref":"#/definitions/Entity"}
        ]
      }
    },
    "edges":{"type":"array","items":{"type":"object"}}
  },
  "notes": "Edges MUST connect nodes of the same tenant_id. Enforce tenant isolation in application and linking pipelines."
}
